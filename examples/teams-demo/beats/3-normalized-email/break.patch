+/-- An email address, stored normalized (trimmed, lower-case), so
+    `Ada@Acme.com` and `ada@acme.com` are one address. -/
+structure Email where
+  raw : String
+  deriving DecidableEq, Repr
+
+def Email.make (s : String) : Except String Email :=
+  let e := s.trimAscii.toString.toLower
+  if e.contains '@' then .ok ⟨e⟩ else .error "not an email address"
+
+instance : ColCodec Email := ColCodec.via (β := String) (·.raw) Email.make
+
